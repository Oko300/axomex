{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/auth/x",          "dest": "/api/auth.js" },
    { "src": "/callback",        "dest": "/api/callback.js" },
    { "src": "/api/status",      "dest": "/api/status.js" },
    { "src": "/api/verify-tweet","dest": "/api/verify-tweet.js" },
    { "src": "/api/form",        "dest": "/api/form.js" },
    { "src": "/(.*)",            "dest": "/public/$1" }
  ]
}